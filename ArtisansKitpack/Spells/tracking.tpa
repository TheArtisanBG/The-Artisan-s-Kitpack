ACTION_IF NOT FILE_EXISTS_IN_GAME ~C0CL922.SPL~ THEN BEGIN

ACTION_IF FILE_EXISTS_IN_GAME ~SPCL922.SPL~ THEN BEGIN

COPY_EXISTING ~SPCL922.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER INT_VAR location = 0 END

  END

APPEND ~splprot.2da~ ~C0_OUTDOORS_CHECK%TAB%0x106%TAB%1%TAB%8~ UNLESS ~C0_OUTDOORS_CHECK~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0_OUTDOORS_CHECK~ BEGIN
	    SET C0_OUTDOORS_CHECK = %row%
	  END
	END

APPEND ~splprot.2da~ ~C0_NOT_OUTDOORS_CHECK%TAB%0x106%TAB%1%TAB%9~ UNLESS ~C0_NOT_OUTDOORS_CHECK~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0_NOT_OUTDOORS_CHECK~ BEGIN
	    SET C0_NOT_OUTDOORS_CHECK = %row%
	  END
	END
	
COPY ~%MOD_FOLDER%/spells/tracking~ ~OVERRIDE~

INCLUDE ~%MOD_FOLDER%/eeex/on_load_eeex.tpa~

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~追踪~) STR_VAR bam_file = SPCL922I RET SPCL922I = icon END

COPY_EXISTING ~C0PR#XX.SPL~ ~OVERRIDE~
	LPF CLONE_EFFECT INT_VAR match_opcode = 326 STR_VAR match_resource = C0PR#X1 resource = SPCL922K	END

COPY_EXISTING ~C0CL922.SPL~ OVERRIDE
	LPF ALTER_EFFECT INT_VAR match_opcode = 318 parameter2 = C0_NOT_OUTDOORS_CHECK END
SAY NAME1 ~追踪~
SAY UNIDENTIFIED_DESC ~追踪
凭借对<PRO_HISHER>周遭环境与栖息生物的熟稔，游侠可使用追踪能力，让<PRO_HIMHER>自身大致探明区域内的生物种类与方位。游侠周围50英尺半径内的所有敌人，都将在战争迷雾中显露身形。9级与18级时，追踪半径将额外增加25英尺。

本能力仅在室外生效。~

COPY_EXISTING ~SPCL922a.SPL~ OVERRIDE
	LPF ALTER_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF (~追踪（激活）~) END
  LPF ALTER_EFFECT INT_VAR match_opcode = 142 parameter2 = SPCL922I END

ADD_PROJECTILE ~%MOD_FOLDER%/spells/tracking/projectile/C0TRKP01.PRO~ ~C0 Tracking 800~
COPY_EXISTING ~C0TRKP01.PRO~ ~OVERRIDE/C0TRKP02.PRO~
  WRITE_SHORT 0x204 1200
  WRITE_SHORT 0x206 1200
ADD_PROJECTILE ~OVERRIDE/C0TRKP02.PRO~ ~C0 Tracking 1200~
COPY_EXISTING ~C0TRKP01.PRO~ ~OVERRIDE/C0TRKP03.PRO~
  WRITE_SHORT 0x204 1600
  WRITE_SHORT 0x206 1600
ADD_PROJECTILE ~OVERRIDE/C0TRKP03.PRO~ ~C0 Tracking 1600~

COPY_EXISTING ~SPCL922B.SPL~ OVERRIDE
	LPF ALTER_EFFECT INT_VAR match_opcode = 326 parameter2 = C0_OUTDOORS_CHECK END

COPY_EXISTING ~SPCL922F.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		projectile = C0TRKP01
END

COPY_EXISTING ~SPCL922G.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		projectile = C0TRKP02
END

COPY_EXISTING ~SPCL922H.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		projectile = C0TRKP03
END

COPY_EXISTING ~SPCL922c.SPL~ OVERRIDE
	LPF ALTER_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF (~追踪（未激活）~) END

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

COPY_EXISTING ~C0CL922.SPL~ ~OVERRIDE/C0STK01.SPL~
  LPF DELETE_EFFECT INT_VAR match_opcode = 318 END
  LPF ALTER_EFFECT STR_VAR match_resource = C0TRACK resource = C0STK01 END

COPY_EXISTING ~SPCL922A.SPL~ ~OVERRIDE/C0STK01A.SPL~
  LPF ALTER_EFFECT STR_VAR match_resource = SPCL922A resource = C0STK01A END
  
COPY_EXISTING ~SPCL922A.EFF~ ~OVERRIDE/C0STK01A.EFF~

COPY_EXISTING ~SPCL922C.SPL~ ~OVERRIDE/C0STK01C.SPL~
	LPF ALTER_EFFECT STR_VAR match_resource = SPCL922A resource = C0STK01A END


END