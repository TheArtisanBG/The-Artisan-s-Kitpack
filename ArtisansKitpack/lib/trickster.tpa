
COPY ~%MOD_FOLDER%/Thief/Trickster/2da~ OVERRIDE
COPY ~%MOD_FOLDER%/Thief/Trickster/bam~ OVERRIDE
COPY ~%MOD_FOLDER%/Thief/Trickster/spells~ OVERRIDE

COPY_EXISTING ~CLABTH01.2DA~ ~OVERRIDE/C0TRICKS.2DA~
	REPLACE_TEXTUALLY ~GA_C0TH-A1~ ~**** ~ // CRIPPLING STRIKE
	REPLACE_TEXTUALLY ~AP_C0TH-A2~ ~**** ~ // EPIC PRECISION

	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0TR#00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0TR#01 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 3 STR_VAR f_Entry = GA_C0TR#02 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0TR#03 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0TR#04 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 5 STR_VAR f_Entry = AP_C0TR#05 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 STR_VAR f_Entry = AP_C0TR#06 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 STR_VAR f_Entry = AP_C0TR#00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 15 STR_VAR f_Entry = AP_C0TR#07 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 STR_VAR f_Entry = AP_C0TR#08 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 STR_VAR f_Entry = AP_C0TR#00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 25 STR_VAR f_Entry = AP_C0TR#09 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 30 STR_VAR f_Entry = AP_C0TR#10 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 35 STR_VAR f_Entry = AP_C0TR#11 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 40 STR_VAR f_Entry = AP_C0TR#12 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 40 STR_VAR f_Entry = AP_C0TR#00 END

 	PRETTY_PRINT_2DA

OUTER_SPRINT kit_description ~模仿士：或许是最难定义、最复杂的盗贼类型，模仿士几乎没有真正属于自己的能力。他们不靠正规训练打磨技艺，而是凭借过人的智谋与强记能力，以近乎瞬发的速度掌握其他职业的技能，运用起来如同浸淫多年——这份天赋常被人嘲讽为一分机智两分运气。因此，绝无两个完全相同的模仿士。作为万事通，他们与吟游诗人的区别在于，其技艺全凭临场领悟而非系统修习。虽说应变灵活、上手极快，但缺乏真正的专精也让他们的成长更为缓慢。

职业优势：
-幸运：所有豁免检定、攻击检定、最小伤害/治疗掷骰+1，所有盗贼技能+5%。
-投机者：模仿士的暴击会使目标的护甲等级、零级命中值与伤害降低1点，持续1回合。
-每日可使用一次「诡术」能力。每提升3级额外获得1次使用次数。

诡术：模仿士以精妙的手法与迅捷的身法，瞬间用一尊与自身等大的替身替换自己，持续1回合，同时进入隐身状态。模仿士的下一次攻击必定暴击。这份障眼法极为逼真，哪怕是破除幻象的魔法、或是能看破隐形的生物也会被蒙骗，在替身存在期间不会攻击模仿士。

-可使用「模仿」能力。

模仿：无论是细心观察、边用边学，还是天赋异禀，模仿士都能模仿几乎任何职业的技能，化为己用。使用后，可永久将该能力替换为另一职业套件的一项能力或被动效果。若为兼职职业，模仿士在该职业非激活状态下仍可使用已学会的能力。

-5级：获得1次模仿使用次数。
-8级：投机者减益效果提升至2点。
-10级：幸运被动加值翻倍。获得1次模仿使用次数。
-15级：投机者减益效果提升至3点。获得1次模仿使用次数。
-20级：幸运被动加值变为三倍。获得1次模仿使用次数。
-25级：获得1次模仿使用次数。
-30级：投机者减益效果提升至4点。获得1次模仿使用次数。
-35级：获得1次模仿使用次数。
-40级：幸运被动加值变为四倍。获得1次模仿使用次数。

职业限制：
-背刺伤害倍率远低于普通盗贼：
  1-8级：2倍
  9级及以上：3倍
-阵营不得为守序。KIT_DISADV_1
-自负：护甲等级受-1惩罚。
-每等级仅可分配20点技能点至盗贼技能。
-作为模仿士，仅能获得90%的经验值。~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~7000~ THEN BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
-无法使用致残打击。
-不获得史诗精准。~

END

END ELSE BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
END

END

