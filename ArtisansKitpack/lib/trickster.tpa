    briefdesc     = RESOLVE_STR_REF(~模仿士：或许是最难定义、最复杂的盗贼类型，模仿士几乎没有真正属于自己的能力。他们不靠正规训练打磨技艺，而是凭借过人的智谋与强记能力，以近乎瞬发的速度掌握其他职业的技能，运用起来如同浸淫多年。因此绝无两个完全相同的模仿士，应变灵活但专精不足。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0TRICKS~
	
    unusable      = ~0x00004000~
