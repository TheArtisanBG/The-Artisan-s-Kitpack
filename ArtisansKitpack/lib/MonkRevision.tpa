	LPF set_clab_2da_entries INT_VAR f_MinLevel = 12 f_Increment = 1 f_MaxLevel = 30 STR_VAR f_Entry = AP_SPCL819 END // DIAMOND SOUL
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 13 STR_VAR f_Entry = AP_C0MN#14 END // QUIVERING PALM
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 14 STR_VAR f_Entry = GA_C0MN#05 END // EMPTY BODY
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 14 STR_VAR f_Entry = GA_C0MN#05 END // EMPTY BODY
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 STR_VAR f_Entry = AP_SPCL821 END // PERFECT SELF

