APPEND ~K_MN_HO.2DA~ ~2    36
3    37~ UNLESS ~2    36~
END

ACTION_FOR_EACH monk_avatar IN 6500 6510 6505 6515 BEGIN
ACTION_IF FILE_EXISTS_IN_GAME ~%monk_avatar%.ini~ THEN BEGIN
COPY_EXISTING ~%monk_avatar%.ini~   ~override~ // Lua file read by EEex, provided by Bubbs and further edited by myself
///////////////////////////////////////////////////////////////////////////
// Update lua file                                                       //
///////////////////////////////////////////////////////////////////////////
  LPF REPLACE_MULTILINE
    INT_VAR
    strict = 1
    verbose = 0
    STR_VAR
    pattern = ~~~~~equip_helmet=1~~~~~
    string = EVAL ~~~~~equip_helmet=0~~~~~ //"
  END
  END
END

OUTER_SET opcode_342_eeex = 0
ACTION_IF MOD_IS_INSTALLED ~EEEX/EEEX.TP2~ ~0~ AND FILE_EXISTS ~EEex_scripts/EEex_Opcode_Patch.lua~ THEN BEGIN
  
  PRINT ~EEex_Opcode_Patch exists.~

COPY_EXISTING ~EEex_scripts/EEex_Opcode_Patch.lua~ ~EEex_scripts~
PATCH_IF ~~ STRING_MATCHES_REGEXP ~Opcode #342~ BEGIN
  SET opcode_342_eeex = 1
  END

ACTION_IF (opcode_342_eeex = 1) THEN BEGIN
  PRINT ~Opcode #342 has been patched.~
    END

END

ACTION_IF NOT (opcode_342_eeex = 1) THEN BEGIN

ACTION_DEFINE_ASSOCIATIVE_ARRAY monk_anims_6xxx BEGIN
    ~6500~ => ~MONK_MALE_HUMAN_1~
    ~6500a~ => ~MONK_MALE_HUMAN_2~
    ~6505~ => ~MONK_MALE_HALFORC_1~
    ~6505a~ => ~MONK_MALE_HALFORC_2~
    ~6510~ => ~MONK_FEMALE_HUMAN_1~
    ~6510a~ => ~MONK_FEMALE_HUMAN_2~
    ~6515~ => ~MONK_FEMALE_HALFORC_1~
    ~6515a~ => ~MONK_FEMALE_HALFORC_2~
  END
  ACTION_PHP_EACH monk_anims_6xxx AS animation => symbol BEGIN
    LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0x6000 RET slot END
    LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
    COPY ~%MOD_FOLDER%/MonkRevision\animations\%animation%.ini~ ~override/%hexNumber%.ini~
    OUTER_SET EVAL ~slot_%folder%~ = slot   // save animation slot number for later
    APPEND ~ANIMATE.IDS~ ~0x%hexNumber% %symbol%~
END

END

ACTION_DEFINE_ASSOCIATIVE_ARRAY halforc_monk_anims_6xxx BEGIN
    ~female~ => ~MONK_FEMALE_HALFORC~
    ~male~ => ~MONK_MALE_HALFORC~
  END
  ACTION_PHP_EACH halforc_monk_anims_6xxx AS folder => symbol BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/MonkRevision\animations\halforc\%folder%~ ~.+\.bam~ ~%MOD_FOLDER%/MonkRevision\animations\halforc\%folder%~ ~.+\.bmp~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
    END
    LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0x6000 RET slot END
    LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
    COPY ~%MOD_FOLDER%/MonkRevision\animations\halforc\female/6515.ini~ ~override/6515.ini~
    COPY ~%MOD_FOLDER%/MonkRevision\animations\halforc\male/6505.ini~ ~override/6505.ini~
    COPY_EXISTING ~6500.ini~ ~override/6501.ini~
    COPY_EXISTING ~6510.ini~ ~override/6511.ini~
    OUTER_SET EVAL ~slot_%folder%~ = slot   // save animation slot number for later
    APPEND ~ANIMATE.IDS~ ~0x6501 MONK_MALE_ELF~
    APPEND ~ANIMATE.IDS~ ~0x6505 MONK_MALE_HALFORC~
    APPEND ~ANIMATE.IDS~ ~0x6511 MONK_MALE_ELF~
    APPEND ~ANIMATE.IDS~ ~0x6515 MONK_FEMALE_HALFORC~
END

// WISDOM
APPEND ~splprot.2da~ ~C0HTWIS 39 -1 1~ UNLESS ~C0HTWIS~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0HTWIS~ BEGIN
	    SET C0HTWIS = %row%
	  END
	END
COPY ~%MOD_FOLDER%/MonkRevision/spells~ ~OVERRIDE~
	LPF ALTER_EFFECT
		INT_VAR
			match_opcode = 326
			match_special = 1000
			parameter2 = C0HTWIS
			silent = 1
	END

DEFINE_ACTION_FUNCTION mod_monk_profs BEGIN
	OUTER_SET count = 0

	ACTION_FOR_EACH class IN
                  monk

	BEGIN
		OUTER_SPRINT $monks("%count%") "%class%"
		OUTER_SET ++count
	END

	COPY_EXISTING kitlist.2da override
		READ_2DA_ENTRIES_NOW kitlist 3
		FOR (row = 2; row < kitlist; ++row) BEGIN // Skip past the vanilla kits
			READ_2DA_ENTRY_FORMER kitlist row 1 label
			READ_2DA_ENTRY_FORMER kitlist row 8 class
			PATCH_IF class = 20 BEGIN // monk
				SPRINT $monks("%count%") "%label%"
				++count
			END
		END
	BUT_ONLY

	COPY_EXISTING ~WEAPPROF.2DA~ override
		READ_2DA_ENTRIES_NOW weapprof 3
		COUNT_2DA_COLS cols
		PHP_EACH monks AS _ => name BEGIN
			FOR (col = 0; col < cols - 1; ++col) BEGIN
				READ_2DA_ENTRY_FORMER weapprof 0 col column_name
				PATCH_IF "%column_name%" STRING_EQUAL_CASE "%name%" BEGIN
					SET_2DA_ENTRY_LATER wweapprof 34 (col + 1) 1
					SET_2DA_ENTRY_LATER wweapprof 34 58 3
					SET_2DA_ENTRY_LATER wweapprof 18 58 3
				END
			END
		END
		SET_2DA_ENTRIES_NOW wweapprof 1
		PRETTY_PRINT_2DA
	BUT_ONLY
END

LAF mod_monk_profs END

INCLUDE ~%MOD_FOLDER%/lib/monk_staves.tpa~

ACTION_FOR_EACH CLASSTEXT IN CLASTEXT SODCLTXT BEGIN
ACTION_IF (FILE_EXISTS_IN_GAME ~%CLASSTEXT%.2da~) BEGIN
  COPY_EXISTING ~%CLASSTEXT%.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~text~ // read column value
	  PATCH_IF ~%text%~ STRING_EQUAL_CASE ~MONK~ BEGIN
	    SET patch_row = %row%
		SET_2DA_ENTRY (%patch_row%) 4 cols RESOLVE_STR_REF (~武僧：武僧是透过沉思和实际行动来追求完美境界的战士。他们是多才多艺的战士，尤其擅长于不穿戴护甲的徒手格斗。虽然武僧无法施法，但他们有专属的特殊法力。这种无形的能量称之为“气”，可透过它的运行展现出惊人的绝技。武僧最广为人知的绝招就是在空手格斗中击晕震慑住对手。

职业特性：

–武僧不能穿戴任何护甲。
–只能选用盗贼职业所使用的武器。
–手杖可达到宗师级精通（5星）。
–其他任意武器类最多仅能达到熟练级（1星）。
–双武器战斗、单武器战斗、双武器风格可达到熟练级（1星）。
–可使用「阴影躲藏」与「寻找陷阱」能力（但无法解除陷阱）。
–移动速度比其他角色快2点。每提升5级，移动速度再提升1点。
–徒手或持手杖时，每回合可攻击2次。
–每3级攻击速度-1。

–疾风连击：武僧徒手、持匕首或飞镖时，每回合首次攻击可额外追加一次攻击，零级命中值受-5惩罚。该额外攻击不受每回合攻击次数上限限制，且可自由切换开启。13级时，零级命中惩罚降低至-2。

–武僧的拳头造成钝击伤害，伤害随等级提升：
  1-2级：1d4
  3-4级：1d6
  5-6级：1d8
  7-9级：1d10
  10-14级：1d12
  15-19级：2d8
  20-24级：2d10
  25级及以上：2d12

–气：武僧的徒手攻击贯注气之力，4级时视为+1附魔魔法武器，8级+2，12级+3，16级+4，20级+5。7级起，视为银质武器。
–所有豁免检定+1。5级起每提升5级额外+1。
–智力每超过12点1点，武僧基础护甲等级+1。5级起每提升5级护甲等级额外+1。
–御箭：每3级，武僧对抗远程攻击的护甲等级+1。
–每日可使用一次「震眩拳」。1级时获得1次，之后每提升4级额外获得1次。

震眩拳：武僧在10秒内的下一次成功攻击，牺牲4点零级命中值与伤害。目标受击时必须进行死亡豁免（智力每超过14点1点，豁免难度-1），失败则震慑3回合。

–3级：心如止水：武僧对抗附魔系法术的豁免检定+2。
–5级：肉身纯净：武僧获得永久自由行动，且免疫所有疾病。
–7级：每日可使用一次「混元体」。

混元体：武僧立即回复自身每等级3点生命值。

–8级：疾风连打：疾风连击激活时，武僧每回合可额外进行第二次攻击。
–11级：钻石身：武僧永久免疫毒素。
–12级：金刚魂：武僧获得基础10%+每等级2%的魔法抗性，30级时达到上限70%。
–13级：每日可使用一次「渗透劲」。

渗透劲：武僧的最高深技法。使用后，10秒内的下一次成功攻击会在目标体内引发致命震颤，目标死亡豁免失败则立即死亡（智力每超过16点1点，豁免难度-1）。

–14级：每日可使用两次「空灵体」。

空灵体：武僧可隐入无形，获得每等级1回合的半隐形效果。攻击武僧的攻击掷骰受-4惩罚，武僧的豁免检定获得+4加值。除非能看破隐形，否则生物无法以法术锁定武僧。

–15级：内眼：武僧徒手时免疫暴击。
–20级：超凡入圣：武僧永久免疫魅惑、支配、命令、睡眠、迷宫、监禁、困惑、灵能，以及所有+1及以下附魔武器。
–阵营限制为守序。
–生命骰：d8~)
	  END
	END
  BUT_ONLY
	END
	END
  
LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~DARK_MOON~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~暗月武僧：暗月教团是信奉黑暗女神莎尔的隐秘僧侣教派。暗月武僧运用肉身技艺、黑暗魔法与种种欺瞒手段掩盖行踪，出手精准致命。

职业优势：
–侦测幻像+10%
–可为侦测幻像技能投入点数
–匕首可达到精通级（3个熟练位）。
–双武器战斗可投入3个熟练位。
–每日可使用一次「术士血脉」。6级与12级时各额外获得1次使用次数。

术士血脉：暗月教团的信徒入门时必须展现出某种法术天赋。因此所有暗月武僧都具备微弱的施法能力。本能力允许暗月武僧每日选择施展一个1环的塑能、幻术或死灵系法术。随着等级提升，可选择更强的法术：5级可选用2环，9级3环，13级4环，17级5环。

–5级：每日可使用一次「冰霜拳」。

冰霜拳：暗月武僧将幽寒能量贯注于徒手攻击中，接下来每5等级1回合内，拳头额外造成1d4魔法寒冷伤害（智力每超过14点1点，额外+1）。

–8级：每日可使用一次「毒蛇击」。

毒蛇击：暗月武僧打出狠厉一击，将腐化之气注入敌人体内。下一次徒手攻击会使目标中毒。毒素立即并在之后每回合造成伤害并降低目标体质，至少持续4回合。4回合后，目标必须进行死亡豁免，失败则再中毒4回合。因此只要目标未成功豁免，毒素就有可能无限持续。目标不会因毒素造成的体质流失而死亡。

1级：目标受到2点毒素伤害，损失1点体质。无豁免惩罚。
6级：目标受到4点毒素伤害，损失1点体质。豁免惩罚-1。
11级：目标受到6点毒素伤害，损失2点体质。豁免惩罚-2。
16级：目标受到8点毒素伤害，损失2点体质。豁免惩罚-3。
21级：目标受到10点毒素伤害，损失3点体质。豁免惩罚-4。

–13级：每日可使用一次「黯影碾压」。

黯影碾压：暗月武僧释放气劲，形成心灵能量波席卷15尺范围内所有生物，施以压倒性绝望，造成10d6魔法伤害并吸取2个等级。每被本能力击杀一个目标，暗月武僧回复最大生命值的15%，并临时获得零级命中值与伤害+2，持续6回合。

–17级：每日可使用一次「月蚀」。

月蚀：暗月武僧周身环绕寒雾一回合，免疫寒冷伤害，力量、敏捷、体质+4。任何在范围内以武器或法术击中暗月武僧的对手，受到1d8+1点寒冷伤害，且必须进行法术豁免，失败则被吸取，额外受到1d6魔法伤害与1点零级命中值，该值临时转移给暗月武僧，持续2回合。

–20级：绝望使者：施放黯影碾压后，暗月武僧从受害者的痛苦中汲取力量，接下来3回合伤害额外+4。此外，在这3回合内击杀任何生物，都能获得与黯影碾压击杀相同的效果，并刷新强化持续时间。

职业限制：
–阵营限制为守序邪恶。
–无法习得日耀或雷霆架势。
–无法使用「震眩拳」能力。
–无法使用「渗透劲」能力。
–无法使用「混元体」能力。~

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~SUN_SOUL~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~日魂武僧：日魂武僧曾是耐瑟瑞尔时代阿曼纳塔的信徒，如今他们分奉洛山达、塞伦涅与苏伦。日魂武僧严守律法，以武道与魔法之力驱逐所见之处的黑暗与腐化。

职业优势：
–免疫目盲与等级吸取。
–每日可使用一次「日魂射线」。5级起每提升5级额外获得1次使用次数。

日魂射线：日魂武僧可凝聚能量形成耀眼光矢。光矢可作为远程投掷物，攻击掷骰+5。每发造成1d4+1点魔法伤害与3点额外魔法火焰伤害（对亡灵为10点），视为+4武器。日魂武僧可生成5发（每5级武僧等级额外+1发），每回合最多投掷5发。

–5级：每日可使用一次「燃烧之拳」。

燃烧之拳：日魂武僧将内在光芒贯注于徒手攻击中，将双拳化为烈焰武器，接下来每5等级1回合内，额外造成1d4魔法火焰伤害（智力每超过14点1点，额外+1）。

–8级：每日可使用一次「灼炎弧击」。

灼炎弧击：日魂武僧在拳中聚气，凝成白热焰浪。武僧下一次成功近战攻击释放出90度锥形火焰，造成5d6魔法火焰伤害并严重灼伤所有目标，使其护甲等级、零级命中值与伤害降低4点，且每回合额外受到1d6魔法火焰伤害，持续1回合，法术豁免成功则无效。此外，所有隐形目标破除隐形，无豁免。

–13级：每日可使用一次「日魂光束」。

日魂光束：日魂武僧以光之巨柱释放气劲，对所有敌人造成10d6魔法伤害，并致盲1回合。亡灵生物必须进行法术豁免，失败则直接被摧毁。

–17级：每日可使用一次「圣日术」。

圣日术：日魂武僧周身环绕光焰一回合，免疫火焰伤害，所有来源造成的火焰伤害提升30%。任何在范围内以武器或法术击中日魂武僧的对手，受到1d8+1点魔法火焰伤害，且必须进行法术豁免，失败则额外受到1d8魔法火焰伤害并致盲1回合。

–20级：阳炎化身：施放日魂光束后，日魂武僧持续散发光芒3回合，护甲等级+6，挥砍、穿刺、钝击与远程伤害抗性+30%。15尺范围内的所有敌人每回合受到1d6魔法伤害，且必须进行-2惩罚的法术豁免，失败则致盲1回合。

职业限制：
–阵营限制为守序善良。
–无法习得月辉或暗影架势。
–无法使用「震眩拳」能力。
–无法使用「渗透劲」能力。
–无法使用「空灵体」能力。~

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~疾风连击~) STR_VAR bam_file = C0MN#04I RET C0MN#04I = icon END

COPY_EXISTING ~clswpbon.2da~ ~override~
  COUNT_2DA_COLS numCols
  COUNT_2DA_ROWS numCols numRows
  FOR (row = 0; row < numRows; row += 1) BEGIN
    SET_2DA_ENTRY row 2 numCols ~0~
  END
  
COPY_EXISTING ~clasiskl.2da~ ~override~
  REPLACE_TEXTUALLY ~^\([ %TAB%]*MAGE\)~ ~CD_DELETE_ME \1~ // adding column to header column
  COUNT_2DA_COLS col_count
  FOR (col = 1 ; col < col_count ; ++col) BEGIN
    READ_2DA_ENTRY 0 col col_count kit
    PATCH_IF ("%kit%" STRING_COMPARE_CASE "DARK_MOON" = 0) BEGIN
      READ_2DA_ENTRY 6 col col_count val
      SET_2DA_ENTRY  6 col col_count (val+10)
      SET col = col_count // kill loop
    END
  END  
  REPLACE_TEXTUALLY ~CD_DELETE_ME ~ ~~ // removing it
  PRETTY_PRINT_2DA
  BUT_ONLY
  
