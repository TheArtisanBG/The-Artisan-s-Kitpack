COPY ~%MOD_FOLDER%/MonkRevision/Ninja/2da~ ~override~
COPY ~%MOD_FOLDER%/MonkRevision/Ninja/spl~ ~override~

LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 20
	
    mixed         = RESOLVE_STR_REF(~忍者~)
	
    lower         = RESOLVE_STR_REF(~忍者~)
	
    help          = RESOLVE_STR_REF(~忍者：忍者是潜行矫健的战士，穿行于暗影之中，出其不意地击倒毫无防备的敌人。忍者精通武器、武道与窃术，来自东方国度，是氏族忠诚的执行者，身兼战士、刺客与密探。

职业特性：
–无法穿戴任何护甲。
–仅可使用盗贼职业可用的武器。
–任意战斗风格可达到专精级（2个熟练位），双武器战斗可分配3个熟练位。
–每等级可获得20点（1级时30点）盗贼技能点数，可分配于：开锁、扒窃、找寻并解除陷阱、无声行动、阴影躲藏、侦测幻象、设置陷阱。
–移动速度比其他角色快2点。每提升5级，移动速度再提升1点。
–每回合可进行2次徒手攻击。
–可以通过使用背刺能力提高伤害。
  1-8级：2倍
  9-16级：3倍
  17级及以上：4倍
–忍者的拳头造成钝击伤害，伤害随等级提升：
  1-2级：1d4
  3-4级：1d6
  5-6级：1d8
  7-9级：1d10
  10-14级：1d12
  15-19级：2d8
  20-24级：2d10
  25级及以上：2d12
–气：忍者的徒手攻击贯注气劲，4级时视为+1附魔魔法武器，8级+2，12级+3，16级+4，20级+5。7级起，视为银质武器。
–所有豁免检定+1。5级起每提升5级额外+1。
–感知每超过12点1点，忍者基础护甲等级+1。5级起每提升5级护甲等级额外+1。
–御箭：每3级，忍者对抗远程攻击的护甲等级+1。
–每日可使用一次「烟雾弹」「设置陷阱」与「淬毒武器」。1级时获得1次，之后每提升6级额外获得1次使用次数。

烟雾弹：在目标位置生成一片烟幕，范围内所有生物致盲且移动速度减半，只要留在烟幕中效果持续。忍者免疫自身烟幕的致盲效果，且只要留在烟幕中就处于隐形状态，可从任意方向发动背刺。烟幕持续2回合，每6级额外持续1回合。

设置陷阱：视野内无敌对生物时，在选定位置布置陷阱。陷阱威力随游荡者等级提升，且仅会被敌人触发。
  1级：造成2d8+5点远程伤害。
  11级：造成2d8+5点远程伤害，且接下来3回合每回合额外造成2d6点毒素伤害。
  16级：造成3d8+5点远程伤害与4d8+2点火焰伤害。
  21级：造成3d8+5点远程伤害与20点毒素伤害，无豁免；若目标死亡豁免（+4加值）失败则直接被斩杀。

淬毒武器：忍者可在武器上涂抹一种发作缓慢但剧毒的毒素，持续8小时。毒素立即并在之后每回合造成伤害并降低目标体质，至少持续4回合。4回合后，目标必须进行死亡豁免，失败则再中毒4回合。因此只要目标未成功豁免，毒素就有可能无限持续。目标不会因毒素造成的体质流失而死亡。
  1级：目标受到2点毒素伤害，损失1点体质。无豁免惩罚。
  6级：目标受到4点毒素伤害，损失1点体质。豁免惩罚-1。
  11级：目标受到6点毒素伤害，损失2点体质。豁免惩罚-2。
  16级：目标受到8点毒素伤害，损失2点体质。豁免惩罚-3。
  21级：目标受到10点毒素伤害，损失3点体质。豁免惩罚-4。

–6级：每次使用烟雾弹可投掷2枚。
–11级：金刚体：忍者永久免疫毒素。
–12级：每次使用烟雾弹可投掷3枚。
–14级：每日可使用两次「空灵体」。、

空灵体：忍者可隐入无形，获得每等级1回合的半隐形效果。攻击忍者的攻击掷骰受-4惩罚，忍者的豁免检定获得+4加值。除非能看破隐形，否则生物无法以法术锁定忍者。

–15级：内眼：忍者徒手时免疫暴击。
–18级：忍者在自身烟幕中时移动速度翻倍。
–22级：忍者在自身烟幕中时，背刺倍率额外+1倍。

–生命骰：d6~)
	
    briefdesc     = RESOLVE_STR_REF(~忍者：忍者是潜行矫健的战士，穿行于暗影之中，出其不意地击倒敌人。忍者精通武器、武道与窃术，来自东方国度，身兼战士、刺客与密探。~)

  STR_VAR
  
    kit_name      = ~C0_NINJA~
	
    unusable      = ~0x00004000~
    // clasweap      = ~1 1 1 1 1 1 1 1~
