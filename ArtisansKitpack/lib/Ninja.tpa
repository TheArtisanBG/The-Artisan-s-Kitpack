LPF ALTER_SPELL_HEADER INT_VAR header = 1 projectile = C0NINJP1 END
LPF ALTER_SPELL_HEADER INT_VAR header = 2 projectile = C0NINJP2 END
LPF ALTER_SPELL_HEADER INT_VAR header = 3 projectile = C0NINJP3 END
