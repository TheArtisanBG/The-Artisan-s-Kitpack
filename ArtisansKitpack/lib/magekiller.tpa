COPY ~%MOD_FOLDER%/Thief/Magekiller/2da~ ~override~
COPY ~%MOD_FOLDER%/Thief/Magekiller/spells~ ~override~

COPY_EXISTING ~CLABTH01.2DA~ ~OVERRIDE/C0MKILL.2DA~
	REPLACE_TEXTUALLY ~GA_SPCL412~ ~**** ~ // SET SNARE
	REPLACE_TEXTUALLY ~GA_C0TH-A1~ ~**** ~ // CRIPPLING STRIKE
	REPLACE_TEXTUALLY ~AP_C0TH-A2~ ~**** ~ // EPIC PRECISION

	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0MK#000 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = GA_C0MK#003 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 8 STR_VAR f_Entry = GA_C0MK#004 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 f_Increment = 10 STR_VAR f_Entry = AP_C0MK#001 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 STR_VAR f_Entry = GA_C0MK#003 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 12 STR_VAR f_Entry = GA_C0MK#005 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 16 STR_VAR f_Entry = GA_C0MK#006 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 15 STR_VAR f_Entry = GA_C0MK#003 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 STR_VAR f_Entry = GA_C0MK#007 END

 	PRETTY_PRINT_2DA

OUTER_SPRINT kit_description ~法师杀手：在魔法遭到恐惧与迫害的地区，擅长追踪与铲除施法者的人才备受追捧。法师杀手是专精追踪、潜行与反魔法的游荡者，在辨识与对抗各类魔法上技艺高超。

职业优势：
–识破幻象+25%。
–对抗法术的豁免检定+2。每提升10级额外+1。
–法师杀手的背刺有几率移除目标身上的魔法效果，效果等同「解除魔法」法术。
–法师杀手的反魔法能力施法时间为1，且视为无法术等级、无学派的能力，因此不受基于法术等级或学派的防护效果影响。
–每日可天生施展一次「破法」。10级与15级时各额外获得1次使用次数。
–8级：每日可天生施展一次「法术免疫」。
–12级：每日可天生施展一次「无效结界」。
–16级：每日可天生施展一次「法术反转」。
–20级：每日可天生施展一次「破盾术」。

职业限制：
–背刺成长弱于普通游荡者：
  1-4级：1倍（无倍率）
  5-8级：2倍
  9-12级：3倍
  13级及以上：4倍KIT_DISADV_1
–每级仅可分配15点技能点数至游荡者技能。
–无法兼职成为法师。
–无法使用「设置陷阱」能力。~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~7000~ THEN BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
–无法使用「致残打击」。
–不获得「史诗精准」。~

END

END ELSE BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
END

END

