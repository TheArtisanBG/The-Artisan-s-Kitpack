    mixed         = RESOLVE_STR_REF(~法师杀手~)
	
    lower         = RESOLVE_STR_REF(~法师杀手~)
	
    help          = RESOLVE_STR_REF(~%kit_description%~)
	
    briefdesc     = RESOLVE_STR_REF(~法师杀手：在魔法遭到恐惧与迫害的地区，擅长追踪与铲除施法者的人才备受追捧。法师杀手是专精追踪、潜行与反魔法的游荡者，在辨识与对抗各类魔法上技艺高超。~)
	
