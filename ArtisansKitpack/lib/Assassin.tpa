SAY NAME1 ~背刺：割喉~ /* Backstab: Cutthroat */
SAY NAME2 ~背刺：割喉~ /* Backstab: Cutthroat */

COPY ~%MOD_FOLDER%/Thief/Assassin/spells/c0asin6.spl~ ~override~
    LPF ALTER_EFFECT
      INT_VAR
	    match_opcode = 142
        parameter2 = c0asic05
      END
SAY NAME1 ~背刺：致命~ /* Backstab: Lethality */
SAY NAME2 ~背刺：致命~ /* Backstab: Lethality */

COPY ~%MOD_FOLDER%/Thief/Assassin/spells/c0assp2.spl~ ~override~
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
	  parameter1 = RESOLVE_STR_REF (~断筋~ /* Hamstrung */)
  END
