COPY_EXISTING ~SPCL415.SPL~ ~OVERRIDE~
LPF ALTER_EFFECT INT_VAR match_opcode = 139 match_parameter1 = 0 parameter1 = RESOLVE_STR_REF (~衰弱~) END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~C0DH#002.SPL~ THEN BEGIN
COPY ~%MOD_FOLDER%/Thief/BountyHunter/SPELLS/manhunter_snare~ ~OVERRIDE~

COPY_EXISTING ~C0DH#002.SPL~ ~OVERRIDE~
SAY NAME1 ~猎者捕网陷阱~
