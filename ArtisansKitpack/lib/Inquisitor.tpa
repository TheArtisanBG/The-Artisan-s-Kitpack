// ICONS

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~否定光环~) STR_VAR bam_file = c0inqi02 RET c0inqi02 = icon END

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~INQUISITOR~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~审判官：审判官毕生致力于搜寻并铲除邪术修习者、击溃黑暗势力，其神祇也为此赋予<PRO_HISHER>特殊的能力。

职业优势：
–免疫定身、魅惑与困惑效果。
–3级：获得「否定光环」被动能力。

否定光环：审判官拥有天生魔法抗性，并将一半抗性赋予20尺范围内的所有友军，同时减慢同范围内所有敌人的施法速度。效果强度如下：

  3级：10%魔法抗性，施法速度-1
  11级：16%魔法抗性，施法速度-1
  19级：32%魔法抗性，施法速度-2

–获得「真理之眼」被动能力。

真理之眼：每回合，审判官有20%+每等级2%的几率驱散20尺范围内的敌方幻象。每个目标单独掷骰判定。

–每日可使用两次「破魔术击」。

破魔术击：审判官的下一次成功攻击会使目标在接下来10秒内法术失败率为100%，并施加相当于自身等级两倍的驱散效果。此外，接下来2回合内目标的施法等级降低5，且施法持续时间减半。

–每日可使用一次「法术反转」。1级时获得1次，之后每提升7级额外获得1次。

–15级：额外获得两次「破魔术击」使用次数。

职业限制：
–不获得基于魅力的神恩加值。
–不获得勇气光环。
–无法驱散不死生物。
–无法使用圣疗术。
–无法使用破邪斩。
–无法施展治病术。
–无法施展牧师法术。~

COPY_EXISTING ~C0INQ01.SPL~ OVERRIDE
  LPF ALTER_EFFECT INT_VAR match_opcode = 142 parameter2 = c0inqi02 END

COPY_EXISTING ~C0INQ03.SPL~ OVERRIDE
  SAY NAME1 ~破魔术击~
  SAY UNIDENTIFIED_DESC ~破魔术击
审判官的下一次成功攻击会使目标在接下来10秒内法术失败率为100%，并施加相当于自身等级两倍的驱散效果。此外，接下来2回合内目标的施法等级降低5，且施法持续时间减半。

破魔术击的效果无视所有武器防护，即便攻击本身被招架也依然生效。~

ACTION_IF (MOD_IS_INSTALLED ~EEEX/EEEX.TP2~ ~0~) THEN BEGIN

COPY_EXISTING ~C0INQ03.spl~ ~override~
SAY UNIDENTIFIED_DESC ~破魔术击
审判官的下一次成功攻击会使目标在接下来10秒内法术失败率为100%，并施加相当于自身等级两倍的驱散效果。此外，接下来2回合内目标的施法等级降低5，且施法持续时间减半。

破魔术击的效果无视所有武器防护，即便攻击本身被招架也依然生效。~

COPY_EXISTING ~numwslot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~text~ // read column value
	  PATCH_IF ~%text%~ STRING_EQUAL_CASE ~INQUISITOR~ BEGIN
	    SET patch_row = %row%
		SET_2DA_ENTRY (%patch_row%) 1 cols 4
	  END
	END

COPY ~%MOD_FOLDER%/lua/m_c0pal2.lua~      ~override~ // Lua file read by EEex, provided by Bubbs and further edited by myself
END

