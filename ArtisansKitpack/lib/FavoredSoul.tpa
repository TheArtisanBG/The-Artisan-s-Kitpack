COMPILE ~%MOD_FOLDER%/strongholds/favored_soul.d~
EXTEND_TOP ~AR0900.BCS~ ~%MOD_FOLDER%/strongholds/scripts/favored_soul.baf~
EXTEND_TOP ~AR0902.BCS~ ~%MOD_FOLDER%/strongholds/scripts/favored_soul_ar0902.baf~
EXTEND_TOP ~AR0904.BCS~ ~%MOD_FOLDER%/strongholds/scripts/favored_soul_ar0904.baf~

  END
  
ACTION_IF FILE_EXISTS_IN_GAME ~SPWI923.SPL~ THEN BEGIN
COPY_EXISTING ~SPWI923.SPL~ ~OVERRIDE/C0FS#H1.SPL~
WRITE_SHORT 0x1C 3
COPY_EXISTING ~SPWI924.SPL~ ~OVERRIDE/C0FS#H2.SPL~
WRITE_SHORT 0x1C 3
END

COPY_EXISTING ~LUCL0.2da~ ~override/LUC0FAV.2DA~
LPF patch_add_hla STR_VAR 2da_row = ~C0FAV1~ ability = ~GA_C0FS#H1~ num_allowed = 1 excluded_by = ~GA_C0FS#H2~ alignment_restrict = ~ALL_EVIL~ END	
LPF patch_add_hla STR_VAR 2da_row = ~C0FAV2~ ability = ~GA_C0FS#H2~ num_allowed = 1 excluded_by = ~GA_C0FS#H1~ alignment_restrict = ~ALL_GOOD~ END
LPF patch_add_hla STR_VAR 2da_row = ~C0FAV3~ ability = ~GA_C0FS#06~ num_allowed = 5 END	

ACTION_IF FILE_EXISTS_IN_GAME ~WISH25.DLG~ THEN BEGIN

COPY_EXISTING ~C0FS#06.spl~ ~override~
SAY NAME1 ~奇迹术~
SAY UNIDENTIFIED_DESC ~奇迹术
（塑能系）

等级：专属
领域：创造、思想
射程：无限制
持续时间：特殊
施法时间：9
影响区域：特殊

豁免检定：无

这道强力法术允许天佑者呼唤其神祇介入当下的处境，降下效果难以预料的干预——且未必总是有益的。效果最弱时，神祇的干预可能只是一件信物或一道法术；而运气极佳的施法者则可能获得强大的赐福，瞬间扭转战局。天佑者的人格力量能为自己撬动命运的天平，因此魅力属性越高，获得有益效果的概率就越大。

然而，过度使用本法术会导致效果递减。每施展一次本法术，后续施法时神祇回应的概率降低20%，直到八小时后才会重置。

本法术最多可选择5次。~

COPY_EXISTING ~C0FS#06A.spl~ ~override~
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 special = RESOLVE_STR_REF (~你的神祇没有回应你的祈求。~) STR_VAR match_resource = C0FS#06A END

COPY_EXISTING ~C0FS#06A.spl~ ~override/C0FS#06B.spl~
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 STR_VAR match_resource = C0FS#06A resource = C0FS#06B END
COPY_EXISTING ~C0FS#06A.spl~ ~override/C0FS#06C.spl~
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 STR_VAR match_resource = C0FS#06A resource = C0FS#06C END
COPY_EXISTING ~C0FS#06A.spl~ ~override/C0FS#06D.spl~
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 STR_VAR match_resource = C0FS#06A resource = C0FS#06D END
COPY_EXISTING ~C0FS#06A.spl~ ~override/C0FS#06E.spl~
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 STR_VAR match_resource = C0FS#06A resource = C0FS#06E END

COPY_EXISTING ~C0FS#06.CRE~ OVERRIDE
WRITE_ASCII 0x2cc ~C0FS#06~ #8  // dialogue
WRITE_ASCII 0x248 ~C0FS#06~ #8  // override
WRITE_ASCII 0x280 ~C0FS#06~ #32 // death variable

COMPILE ~%MOD_FOLDER%/FavoredSoul/dialogue/miracle.d~
COMPILE ~%MOD_FOLDER%/FavoredSoul/scripts/C0FS#06.baf~

END