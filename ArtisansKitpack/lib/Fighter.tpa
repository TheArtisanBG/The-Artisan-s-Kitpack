    LPF ALTER_EFFECT INT_VAR match_opcode = 233 parameter2 = 106 END
COPY_EXISTING ~c0fig04a.spl~ ~override/c0fig04s.spl~
    LPF ALTER_EFFECT INT_VAR match_opcode = 233 parameter2 = 107 END
COPY_EXISTING ~c0fig04a.spl~ ~override/c0fig04t.spl~
    LPF ALTER_EFFECT INT_VAR match_opcode = 233 parameter2 = 115 END

// Continue doing the above for all profs

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~猛力攻击~) STR_VAR bam_file = C0FIG01I RET C0FIG01I = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~精通猛力攻击~) STR_VAR bam_file = C0FIG01J RET C0FIG01J = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~寓守于攻~) STR_VAR bam_file = C0FIG02I RET C0FIG02I = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~精通寓守于攻~) STR_VAR bam_file = C0FIG02J RET C0FIG02J = icon END

