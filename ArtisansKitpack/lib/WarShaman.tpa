	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 21
	
    mixed         = RESOLVE_STR_REF(~战号萨满~)
	
    lower         = RESOLVE_STR_REF(~战号萨满~)
	
    help          = RESOLVE_STR_REF(~%warhorn_rage_desc%~)
	
    briefdesc     = RESOLVE_STR_REF(~战号萨满：出身北方的战士萨满，能召唤战士之灵助战，信奉战争之主坦帕斯，战斗与施法能力同样出众。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0WSHAM~
	
    unusable      = ~0x00004000~
    // clasweap      = ~1 1 1 1 1 1 1 1~
	//                                       T   S           F   Q             S S
	//                                       W   C           L   U             W I
	//                               B L S   O   I   W       A   A             O N
