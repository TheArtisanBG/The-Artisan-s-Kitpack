COPY ~%MOD_FOLDER%/Druid/Shapeshifter/spells/C0SS-HL2.spl~ ~override~
SAY NAME1 ~狼群~
SAY UNIDENTIFIED_DESC ~狼群
变形者处于狼人形态时，15尺范围内所有其他处于狼人形态的友军（无论本身是变形者还是共感恩赐的受益者），攻击与伤害获得+2加值。

需求：共感恩赐~

COPY ~%MOD_FOLDER%/Druid/Shapeshifter/spells/C0SS-HL3.spl~ ~override~
SAY NAME1 ~元素狂怒~
SAY UNIDENTIFIED_DESC ~元素狂怒
每日可使用一次，变形者可选择一种元素（火焰、寒冷、电击、强酸）。选定后，变形者处于狼人形态时永久免疫该元素，且每次命中额外造成2d6点伤害。可再次使用本能力切换选定的元素。~

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~狂怒：火牙~) STR_VAR bam_file = C0SS-FII RET C0SS-FII = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~狂怒：霜噬~) STR_VAR bam_file = C0SS-COI RET C0SS-COI = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~狂怒：酸蚀~) STR_VAR bam_file = C0SS-ACI RET C0SS-ACI = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~狂怒：雷爪~) STR_VAR bam_file = C0SS-ELI RET C0SS-ELI = icon END

