
COPY ~%MOD_FOLDER%/Druid/TotemicDruid/2DAs~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/Druid/TotemicDruid/SPELLS~ ~OVERRIDE~

ACTION_IF FILE_EXISTS_IN_GAME ~CLABDR02.2DA~ BEGIN
COPY_EXISTING ~CLABDR02.2DA~ ~OVERRIDE~
  REPLACE_TEXTUALLY ~GA_SPCL621~ ~****      ~
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 1 STR_VAR f_Entry = GA_C0D2_A0 END
  PRETTY_PRINT_2DA
END

OUTER_SPRINT kit_description ~图腾德鲁伊：这名德鲁伊与某一特定动物深度共鸣，<PRO_HESHE>认为这只动物正是<PRO_HISHER>灵魂的化身。这份羁绊赋予<PRO_HIMHER>与动物王国的特殊联结，<PRO_HESHE>能够呼唤动物之灵前来助<PRO_HIMHER>一臂之力。

职业优势：
-可使用特殊能力「图腾守护灵」。

图腾守护灵：图腾德鲁伊始终受一只动物灵的守护。进入战斗时灵体便会显现，战斗结束后方才散去。灵体可被操控，威力随召唤者的德鲁伊等级提升。图腾德鲁伊每日可选择一只守护灵，每种灵体都会为15尺范围内所有德鲁伊、萨满、游侠与野蛮人提供不同的加值。
  熊之坚韧：召唤者物理抗性+10%，死亡豁免+1。
  狼之骁勇：召唤者造成的所有伤害+10%，近战伤害额外+1。
  狮之勇气：召唤者零级命中值、士气与法术豁免+1。
  蛇之迅捷：召唤者护甲等级、移动速度与呼吸豁免+1。

-5级：守护灵在场时，可使用「灵护」能力。该能力由守护灵的特殊能力栏施放，而非召唤者自身。

灵护：图腾德鲁伊可命令守护灵将自身力量灌注给指定目标，持续1回合。期间守护灵暂时隐去，无论目标职业为何，均可获得守护灵的全部加值。效果结束后，守护灵会重新现身于召唤者身侧。

-8级：图腾守护灵的各项效果提升至+15%/+2。
-10级：灵护可为目标恢复相当于最大生命值50%的生命。
-12级：灵护可移除目标身上的负面心灵效果，并在持续期间为目标提供同类效果免疫。
-14级：图腾守护灵的各项效果提升至+20%/+3。
-14级：灵护可对已死亡的友军施放，将其复活后再提供常规加值。但守护灵会为此耗尽力量。此外，只要图腾德鲁伊正受守护灵庇护，即可获得「死亡护盾」法术的效果，免疫即死效果。若在此保护下将受到致命伤害，守护灵会耗尽力量挡下攻击，并对其施放灵护。
-15级：图腾守护灵的各项效果提升至+25%/+4。灵护可为目标恢复相当于最大生命值100%的生命。

职业限制：
-无法使用变形术。
-若图腾德鲁伊的守护灵在战斗中被击溃，或为复活友军、保护召唤者免于死亡而耗尽力量，则需经过一整回合且战斗仍在进行时才能重新显现。发生这种情况时，图腾德鲁伊施法速度受-2惩罚，且一回合内有25%几率法术失手。~

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~TOTEMIC_DRUID~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~%kit_description%~

// ICONS

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~灵：熊~) STR_VAR bam_file = C0D2_I1 RET C0D2_I1 = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~灵：狼~) STR_VAR bam_file = C0D2_I2 RET C0D2_I2 = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~灵：狮~) STR_VAR bam_file = C0D2_I3 RET C0D2_I3 = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~灵：蛇~) STR_VAR bam_file = C0D2_I4 RET C0D2_I4 = icon END

