ACTION_FOR_EACH baldur_script IN baldur bdbaldur baldur25 BEGIN
ACTION_IF FILE_EXISTS_IN_GAME ~%baldur_script%.bcs~ BEGIN
EXTEND_TOP ~%baldur_script%.bcs~ ~%MOD_FOLDER%/Druid/TotemicDruid/scripts/baldur.baf~
END
END

COMPILE ~%MOD_FOLDER%/Druid/TotemicDruid/scripts/C0D2_SM.BAF~

COPY ~%MOD_FOLDER%/Druid/TotemicDruid/creatures/C0D2_S1.cre~ ~OVERRIDE~
SAY NAME1 ~灵熊~
SAY NAME2 ~灵熊~
  WRITE_ASCII SCRIPT_OVERRIDE ~C0D2_SM~ #8 // override
  WRITE_ASCII DEATHVAR ~C0D2_SM~ #8 // death variable

