LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 6

    mixed         = RESOLVE_STR_REF(~秘火骑士~)

    lower         = RESOLVE_STR_REF(~秘火骑士~)

    help          = RESOLVE_STR_REF(~秘火骑士：秘火骑士是侍奉魔法女神蜜斯特拉的圣武士。他们既精通近战格斗，也擅长奥术魔法。除了恪守圣武士的传统美德外，秘火骑士还将毕生精力投入到古老魔法的发掘与研习之中。

职业优势：
–每等级学识+2。
–每等级可额外施展两个法术。
–对抗法术的豁免检定+1。5级起每提升5级额外+1。
–秘火骑士施法时，视为同等级的牧师。
–可记诵少量法师法术：
 1环：魔法飞弹、电击掌、护盾术、召唤魔宠
 2环：镜像术、蛛网术、阿加纳扎灼击术、隐形术
 3环：火球术、闪电箭、加速术、初级法术偏转
 4环：高等厄运诅咒、火焰护盾·赤、石肤术、秘语术
<MF_LEVEL5><MF_LEVEL6><MF_LEVEL7>
–每日可使用一次「破法术击」，之后每提升6级额外获得1次使用次数。

破法术击：秘火骑士可制裁施法者，扰乱其防御法术与施法能力。两回合内秘火骑士的下一次攻击会驱散目标的战斗防护效果。此外，若目标法术豁免失败（难度-2），则两回合内法术失败率为100%。

–5级起，每日可使用一次「法术之刃」。

法术之刃：秘火骑士为自身武器附魔一小时，武器获得+3附魔等级，额外造成1d4魔法伤害（每5级+1d4，20级上限），且每次命中降低目标5%魔法抗性，持续2回合。12级时附魔提升至+4，18级时提升至+5。

–12级：战斗施法：秘火骑士精于战斗中施法。若5尺内存在敌人，施法速度+2。

职业限制：
–生命骰：d8
–无法习得以下高阶能力：高等旋风攻击、高等致命一击、制裁、强健
–不获得勇气光环。
–无法使用破邪斩。
–无法使用防护邪恶。
–无法驱散不死生物。
–无法使用圣疗术。~)

    briefdesc     = RESOLVE_STR_REF(~秘火骑士：秘火骑士是侍奉魔法女神蜜斯特拉的圣武士。他们既精通近战格斗，也擅长奥术魔法，毕生致力于古老魔法的发掘与研习。~)
	
	// fallen = 1
	
  STR_VAR
    kit_name      = ~C0MF~
	
    unusable      = ~0x00000000~
