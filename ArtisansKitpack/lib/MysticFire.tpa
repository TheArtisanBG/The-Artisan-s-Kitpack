COPY ~%MOD_FOLDER%/Paladin/MysticFire/spells/c0mf01.spl~ ~override~
SAY NAME1 ~破法术击~
SAY NAME2 ~破法术击~
SAY UNIDENTIFIED_DESC ~破法术击
秘火骑士可制裁施法者，扰乱其防御法术与施法能力。两回合内秘火骑士的下一次攻击会驱散目标的战斗防护效果。此外，若目标法术豁免失败（难度-2），则两回合内法术失败率为100%。~
COPY ~%MOD_FOLDER%/Paladin/MysticFire/spells/c0mf01a.spl~ ~override~
	LPF ALTER_EFFECT
		INT_VAR
			match_opcode = 139
			match_parameter2 = 1
			parameter1 = RESOLVE_STR_REF (~法术防护已移除~)
		END
	LPF ALTER_EFFECT
		INT_VAR
			match_opcode = 139
			match_parameter2 = 0
			parameter1 = RESOLVE_STR_REF (~法术失控~)
		END
 
ACTION_IF (MOD_IS_INSTALLED ~EEEX/EEEX.TP2~ ~0~) THEN BEGIN

COPY_EXISTING ~c0mf01.spl~ ~override~
SAY UNIDENTIFIED_DESC ~破法术击
秘火骑士可制裁施法者，扰乱其防御法术与施法能力。两回合内秘火骑士的下一次攻击会驱散目标的战斗防护效果。此外，若目标法术豁免失败（难度-2），则两回合内法术失败率为100%。

破法术击的效果无视所有武器防护，即便攻击本身被招架也依然生效。~

OUTER_SET mystic_fire_ids = IDS_OF_SYMBOL (~kit~ ~C0MF~)
  
COPY ~%MOD_FOLDER%/lua/m_c0pal1.lua~      ~override~ // Lua file read by EEex, provided by Bubbs and further edited by myself
///////////////////////////////////////////////////////////////////////////
// Update lua file                                                       //
///////////////////////////////////////////////////////////////////////////
  LPF REPLACE_MULTILINE
    INT_VAR
    strict = 1
    verbose = 0
    STR_VAR
    pattern = ~~~~~0x4000~~~~~
    string = EVAL ~~~~~%mystic_fire_ids%~~~~~ //"
  END

END

