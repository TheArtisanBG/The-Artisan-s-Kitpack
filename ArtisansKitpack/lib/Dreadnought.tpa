DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~猛攻姿态~) STR_VAR bam_file = c0dred3i RET c0dred3i = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~裂地一击~) STR_VAR bam_file = c0dred5i RET c0dred5i = icon END

