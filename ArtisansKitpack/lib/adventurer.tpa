
COPY ~%MOD_FOLDER%/Thief/Adventurer~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/Thief/Adventurer/spells~ ~OVERRIDE~

COPY_EXISTING ~CLABTH01.2DA~ ~OVERRIDE/C0ADVENT.2DA~
	REPLACE_TEXTUALLY ~GA_C0TH-A1~ ~**** ~ // CRIPPLING STRIKE

	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 3 STR_VAR f_Entry = AP_C0ADV01 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = GA_C0ARC03 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0ADV00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 18 STR_VAR f_Entry = AP_C0ADV00 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 4 f_Increment = 4 STR_VAR f_Entry = GA_SPCL121 END

 	PRETTY_PRINT_2DA

OUTER_SPRINT kit_description ~游荡射手：许多游荡者出于务实考量选择使用远程武器，习惯于在安全距离外接战。游荡射手精于此道，远距交锋时不逊于任何战士，无需身犯险境，便能以致命的投射物击倒敌人。

职业优势：
–1级起，所有远程武器的命中与伤害掷骰获得+1加值，之后每提升3级再+1。
–远视：游荡射手的视野范围略高于常人，处于潜行或隐形状态时会进一步提升。
–可将任意远程武器修习至精通级（3点熟练槽）。
–可使用「速射」攻击模式。

速射：射手每轮可额外进行一次攻击，但命中受-4惩罚。

–每日可使用一次「精准射击」能力。4级时增加一次使用次数，之后每提升4级再增加一次。

精准射击：接下来10秒内，所有成功命中的远程攻击除造成正常伤害外，还将根据游荡射手的等级叠加以下效果：
 4级：目标的零级命中值（THAC0）受-1惩罚。
 8级：目标的法术豁免检定受-1惩罚。
 12级：目标的力量属性受-1惩罚。
 16级：伤害掷骰获得+2加值。

–12级：精通速射：速射状态下的命中惩罚降低至-2。
–18级：狙击：潜行或隐形状态下，射手的远程攻击必定暴击。

职业限制：
–无法使用背刺能力。KIT_DISADV_1~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~7000~ THEN BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
–无法使用「致残打击」。~

END

END ELSE BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
END

END

