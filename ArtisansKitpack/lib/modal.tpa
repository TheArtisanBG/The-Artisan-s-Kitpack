COPY ~%MOD_FOLDER%/modal~ ~override~

ACTION_FOR_EACH modals IN C0FIG01 C0FIG02 C0ARC03 C0MN#04 C0DWD03 C0AAIN4 C0IVB02 C0KN#03 C0CL922 C0STK01 C0TH-A1 BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%modals%.spl~ THEN BEGIN
    COPY_EXISTING ~%modals%.spl~ ~override~
    LPF ALTER_SPELL_HEADER INT_VAR location = 0 END
  END
END

ACTION_IF FILE_EXISTS_IN_GAME ~C0FIG01.SPL~ BEGIN
COPY_EXISTING ~C0FIG01.SPL~ ~OVERRIDE~
SAY NAME1 ~^0xFF100001 ^-猛力攻击~
SAY UNIDENTIFIED_DESC ~猛力攻击
战士牺牲精准度换取更沉重、更具杀伤力的打击，近战零级命中值降低3点，近战伤害提升3点。战士力量需达到17或以上才能激活此能力。~
END

