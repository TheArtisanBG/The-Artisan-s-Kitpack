COPY ~%MOD_FOLDER%/Thief/InvisibleBlade/2da~ ~override~
COPY ~%MOD_FOLDER%/Thief/InvisibleBlade/spells~ ~override~

COPY_EXISTING ~CLABTH01.2DA~ ~OVERRIDE/C0INVBL.2DA~
	REPLACE_TEXTUALLY ~GA_SPCL412~ ~**** ~ // SET SNARE
	REPLACE_TEXTUALLY ~GA_C0TH-A1~ ~**** ~ // CRIPPLING STRIKE
	REPLACE_TEXTUALLY ~AP_C0TH-A2~ ~**** ~ // EPIC PRECISION

	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0IVBP1 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = GA_C0IVB02 END
	LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 1 STR_VAR f_Entry = AP_C0IVBP2 END

 	PRETTY_PRINT_2DA

OUTER_SPRINT kit_description ~无踪短刃：无踪短刃是致命的战士，偏好使用匕首及同类武器作战。他们对这类武器的训练与技法，使其杀伤力丝毫不逊于任何全副武装的战士。无踪短刃乐于让他人低估自己的危险程度，也热衷于抓住一切机会证明：最不起眼的武器，往往最致命。

职业优势：
–匕首可达到宗师级精通（5个熟练位）。
–双武器战斗可达到精通级（3个熟练位）。
–持匕首时命中+1。每偶数等级额外+1，20级时达到上限+11。
–自由身法：智力每超过12点1点，无踪短刃的基础护甲等级就提升1点。
–流血不止：无踪短刃使用匕首的背刺会使目标流血不止，首次命中造成额外穿刺伤害，之后数回合造成无视护甲伤害。攻击必须造成伤害才能触发流血不止，同一目标可叠加该效果。
  1-4级：每回合2点伤害，持续2回合
  5-8级：每回合3点伤害，持续4回合
  9-12级：每回合4点伤害，持续8回合
  12-16级：每回合6点伤害，持续8回合
  17级及以上：每回合8点伤害，持续10回合
  无血液的目标免疫流血不止，但仍承受正常背刺伤害。

–可使用「虚招」攻击模式。

虚招：无踪短刃做出假动作诱使对手露出破绽，趁其不备发动攻击。虚招激活时，本回合无踪短刃每回合攻击次数减半，近战攻击会迫使目标进行强韧豁免（难度+4，每3级难度惩罚-1），失败则目标敏捷减半，持续1回合，并附加流血不止效果。每回合对单个目标仅可尝试一次虚招。虚招对无智生物（如魔像、史莱姆）无效。

–12级：虚招大师：虚招状态下，无踪短刃每回合的首次攻击必定视为背刺，并额外叠加一层流血不止。

职业限制：
–背刺倍率最高仅为2倍。KIT_DISADV_1
–无法穿戴任何护甲。
–每级仅可分配15点技能点数至游荡者技能。
–无法使用「设置陷阱」能力。~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~7000~ THEN BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
–无法使用「致残打击」。
–不获得「史诗精准」。~

END

END ELSE BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
END

END

// INTELLIGENCE
APPEND ~splprot.2da~ ~C0HTINT%TAB%38%TAB%-1%TAB%1~ UNLESS ~C0HTINT~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0HTINT~ BEGIN
	    SET C0HTINT = %row%
	  END
	END
	
