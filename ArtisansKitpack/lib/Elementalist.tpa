LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 11
	
    mixed         = RESOLVE_STR_REF(~元素使~)
	
    lower         = RESOLVE_STR_REF(~元素使~)
	
    help          = RESOLVE_STR_REF(~元素使：元素使德鲁伊专精于自然的本源能量，得以凭借超凡的技艺驾驭四大元素。

职业优势：
–对强酸、寒冷、电击与火焰伤害获得+20%抗性。
–造成的强酸、寒冷、电击与火焰伤害提升+20%。
–施展奥术版的防护火焰、防护寒冷、防护电击、防护强酸与元素防护时，施法距离增加，且施法时间缩短为1。
–从1环到7环，每个法术环级都将有3个奥术法术加入<PRO_HISHER>的法术列表，具体如下：
  1环：燃烧之手、寒冷之触、电击掌
  2环：阿加纳扎的灼烧术、麦夫的酸箭、斯诺洛克的雪球群
  3环：火球术、冰枪术、闪电束
  4环：火焰护盾（红色）、冰风暴、强酸法球
  5环：寒冰锥、防护强酸、阳炎术
  6环：连锁闪电、死亡之雾、奥提路克的冷冻球
  7环：酸雨风暴、延迟爆焰火球、元素防护

职业限制：
–无法穿戴任何护甲。
–无法施展动物领域与非元素召唤领域的任何法术。
–无法变形为任何动物形态。~)
	
    briefdesc     = RESOLVE_STR_REF(~元素使：元素使德鲁伊专精于自然的本源能量，得以凭借超凡的技艺驾驭四大元素。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0ELEM~
	
    unusable      = ~0x10000000~
