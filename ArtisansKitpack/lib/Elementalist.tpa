// VITRIOLIC SPHERE

ACTION_IF NOT FILE_EXISTS_IN_GAME ~SPWI432.SPL~ THEN BEGIN
COPY ~%MOD_FOLDER%/Druid/Elementalist/iwdspells/vitriolic~ ~override~
