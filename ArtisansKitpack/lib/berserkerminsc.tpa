COPY ~ArtisansKitpack/Ranger/BerserkerMinsc/2da~ ~override~
COPY ~ArtisansKitpack/Ranger/BerserkerMinsc/spells~ ~override~

COPY_EXISTING ~CLABRN01.2DA~ ~OVERRIDE/C0TBM.2DA~
	// REPLACE_TEXTUALLY ~AP_C0RNH[%0-9%] ~ ~**** ~ // TOUGHNESS
	// REPLACE_TEXTUALLY ~AP_C0RNH[%0-9%][%0-9%] ~ ~**** ~ // TOUGHNESS
