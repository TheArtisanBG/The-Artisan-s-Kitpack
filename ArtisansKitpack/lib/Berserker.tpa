COPY ~%MOD_FOLDER%/Fighter/Berserker/2DA~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/Fighter/Berserker/BAMS~ ~OVERRIDE~
COPY ~%MOD_FOLDER%/Fighter/Berserker/SPELLS~ ~OVERRIDE~

// CURRENT HP CHECK
APPEND ~splprot.2da~ ~C0CURHP 0 -1 0~ UNLESS ~C0CURHP 0 -1 0~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0CURHP~ BEGIN
	    SET C0CURHP = %row%
	  END
	END

COPY_EXISTING ~CLABFI01.2DA~ ~OVERRIDE/CLABFI02.2DA~
  // REPLACE_TEXTUALLY ~GA_C0FIG01~ ~**** ~ // POWER ATTACK
  REPLACE_TEXTUALLY ~GA_C0FIG02~ ~**** ~ // EXPERTISE
  REPLACE_TEXTUALLY ~GA_C0ARC03~ ~**** ~ // RAPID SHOT
  REPLACE_TEXTUALLY ~AP_C0ARC03Z~ ~**** ~
  REPLACE_TEXTUALLY ~AP_C0FIG04~ ~**** ~ // SPECIALIZATION
  // REPLACE_TEXTUALLY ~AP_C0FIG03~ ~**** ~ // IMPROVED INITATIVE

  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0BER#07 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0BER#1X END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0BER#2X END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0BER#3X END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 STR_VAR f_Entry = AP_C0BER#I1 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 4 STR_VAR f_Entry = GA_C0BER#05 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 4 STR_VAR f_Entry = GA_C0BER#00 END

  PRETTY_PRINT_2DA

OUTER_SPRINT kit_description ~狂战士：这类战士深谙自身的兽性本能，战斗中能进入一种极致亢奋的精神状态，让自己比常人更持久、更凶猛、更狂野地战斗。狂战士的天性大多类同野蛮人，但并非一概如此——有时这是受训战士主动做出的选择。无论如何，当战场上的对手目睹狂战士性格中狂野、非人的一面时，都会心神不宁。该职业在矮人之中十分常见，他们称其为「战狂者」。

职业优势：
-免疫恐惧、士气崩溃与非自愿狂暴效果。
-获得「死斗」被动效果。

死斗：狂战士嗜享厮杀的快感，近乎施虐受虐的程度；当大多数战士都会动摇或撤退的生死关头，他们反而越战越勇。这份力量虽强，却是双刃剑——战斗中受伤越重，攻势就越发致命，但防御也随之下降，更容易受到更多伤害。
  生命值>75%：近战零级命中值与伤害+2，护甲等级-2
  生命值>50%：近战零级命中值与伤害+4，护甲等级-4
  生命值>25%：近战零级命中值与伤害+8，护甲等级-6

-每日可使用一次「狂怒」能力。1级时获得1次使用次数，之后每提升4级额外获得1次。

狂怒：狂战士仅凭纯粹的意志力引爆自身的狂乱。接下来2回合内，<PRO_HESHE>获得+15点最大生命值，每秒损失1点生命值，且每损失5%生命值，斩击、穿刺与钝击伤害便额外+5%（生命值仅剩1点时伤害+100%）。若狂怒剩余持续时间不足1回合，狂战士的近战攻击会将狂怒持续时间重置为1回合，总持续时间最长可达10回合。狂怒造成的生命值损失不会将狂战士的生命值降至1点以下。狂怒状态下，狂战士无法施法。

-4级起，可随意使用「鲁莽狂暴」能力。

鲁莽狂暴：狂战士故意伤及自身，立刻将<PRO_HISHER>生命值降至最大生命值的70%、45%或20%。若狂战士当前生命值已低于所选数值，本技能无效。

-7级起，死斗状态下狂战士的移动速度获得+2/+4/+8加成。

-10级起，狂战士的恍惚状态让<PRO_HIMHER>更易摆脱负面效果，死斗状态下所有豁免检定获得+2/+4/+8加成。

-14级起，死斗状态下狂战士每回合额外攻击次数获得+0.5/+1/+2加成。

-20级起，死斗状态下，狂战士造成与受到的伤害掷骰获得+1/+3/+5幸运加值。

职业限制：
-使用狂怒后会气喘吁吁5回合，期间护甲等级、命中掷骰与伤害掷骰受-2惩罚。此外，气喘吁吁状态下，狂战士无法使用狂怒，也无法获得死斗的增益。
-无法精通远程武器。KIT_DISADV_1
-仅限非守序阵营。~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~1100~ THEN BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
-无法使用「武器娴熟」与「速射」。
-16级时不会获得全武器专精。~

END

END ELSE BEGIN

OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
  REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
END

END

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~BERSERKER~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~%kit_description%~

// ICONS

DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~死斗~) STR_VAR bam_file = c0ber#ic RET c0ber#ic = icon END

