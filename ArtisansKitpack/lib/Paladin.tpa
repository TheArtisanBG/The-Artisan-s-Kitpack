	INT_VAR
		projectile = C0INAREP
END

COPY_EXISTING ~C0PAL04B.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		projectile = C0INAREP
END

COPY_EXISTING ~C0PAL04C.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		projectile = C0INAREP
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~#PALDISE.SPL~ BEGIN
COPY ~%MOD_FOLDER%/Paladin/Spells/iwdee/#PALDISE.SPL~ OVERRIDE
END
	
ACTION_IF NOT FILE_EXISTS_IN_GAME ~#PALFEAR.SPL~ BEGIN
COPY ~%MOD_FOLDER%/Paladin/Spells/iwdee/#PALFEAR.SPL~ OVERRIDE
END
	
COPY ~%MOD_FOLDER%/Paladin/Spells/C0PAL05.SPL~ OVERRIDE
SAY NAME1 ~治愈疾病~
SAY UNIDENTIFIED_DESC ~治愈疾病
（防护系）

等级：3
射程：触碰
学派：死灵系
持续时间：即时
施法时间：9
影响范围：1个生物
豁免检定：无

对患病目标施放本法术后，可立即治愈其疾病并恢复5点生命值。治愈效果永久，但不会使目标免疫后续的同类病症。目盲与耳聋也可借此术治愈。本法对不死生物、构装生物或异界生物无效。~