DEFINE_ACTION_FUNCTION cd_new_portrait_icon
  INT_VAR string = 0
  STR_VAR bam_file = "****"
  RET     icon
  BEGIN

  COPY_EXISTING ~statdesc.2da~ ~override~
    COUNT_2DA_ROWS 3 count
    READ_2DA_ENTRY (count - 1) 0 3 icon
    SET icon += 1

  APPEND ~statdesc.2da~ ~%icon% %string% %bam_file%~ UNLESS ~%bam_file%~

END

LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~奥术之拳~) STR_VAR bam_file = C0EFNSI RET C0EFNSI = icon END
LAF cd_new_portrait_icon INT_VAR string = RESOLVE_STR_REF(~能量之拳~) STR_VAR bam_file = C0EFN2I RET C0EFN2I = icon END

// WISDOM
APPEND ~splprot.2da~ ~C0HTWIS 39 -1 1~ UNLESS ~C0HTWIS~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0HTWIS~ BEGIN
	    SET C0HTWIS = %row%
	  END
	PRETTY_PRINT_2DA
	END
	
COPY_EXISTING ~C0EFN1.SPL~ OVERRIDE
SAY NAME1 ~震慑拳~
SAY UNIDENTIFIED_DESC ~震慑拳
启迪之拳牺牲4点THAC0与伤害，在接下来10秒内的下一次成功命中时生效。目标受击后必须进行死亡豁免（智慧每高于14点，豁免获得-1调整值），失败则震慑3轮。~
	LPF ALTER_EFFECT
		INT_VAR
			match_opcode = 326
			match_special = 1000
			parameter2 = C0HTWIS
			silent = 1
	END

COPY_EXISTING ~C0EFN2.SPL~ OVERRIDE
  LPF ALTER_EFFECT INT_VAR match_opcode = 142 parameter2 = C0EFN2I END
SAY NAME1 ~能量之拳~
