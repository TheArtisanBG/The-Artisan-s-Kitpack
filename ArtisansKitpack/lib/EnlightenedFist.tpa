LPF patch_remove_hla STR_VAR remove_ability = ~GA_SPCL928~ END
LPF patch_remove_hla STR_VAR remove_ability = ~GA_SPCL929~ END
LPF patch_remove_hla STR_VAR remove_ability = ~GA_SPCL930~ END
