 	PRETTY_PRINT_2DA

LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 12
	
    mixed         = RESOLVE_STR_REF(~黑暗猎人~)
	
    lower         = RESOLVE_STR_REF(~黑暗猎人~)
	
    help          = RESOLVE_STR_REF(~黑暗猎人：黑暗猎人将潜行与生存技艺用于渗透、谍报与追猎，必要时正面作战的能力也毫不逊色。在普通林间游侠眼中，他们不过是名义上的游侠；但在公会与权势集团中，作为刺客与情报搜集者的黑暗猎人往往更受欢迎。

与普通游侠不同，黑暗猎人无阵营限制；且他们的力量并非神祇所赐，因此永远不会堕落。

职业优势：
–可使用背刺能力，但伤害倍率低于盗贼：
  1-8级：2倍
  9-16级：3倍
  17级及以上：4倍
–对抗类人生物时，命中与伤害+2。
–每个区域最多可布设6个陷阱。
–可记忆少量法师法术：
  1环：魅惑人类、夜视术、一级召唤怪物、镜像术
  2环：模糊术、隐形术、敲击术、二级召唤怪物
  3环：识破幻象、幽灵护甲、定身术、三级召唤怪物
–每日可使用一次「淬毒武器」能力，每提升5级额外获得一次使用次数。

淬毒武器：黑暗猎人可为<PRO_HISHER>武器涂抹起效缓慢但药性猛毒的剧毒，持续8小时。该毒素造成伤害，并立即及之后每回合降低目标体质，至少持续4回合。4回合过后，目标必须进行一次死亡豁免，否则将再中毒4回合。因此只要目标未能成功豁免，毒素就有可能无限期持续。目标不会因毒素造成的体质流失而死亡。
  1级：目标受到2点毒素伤害，损失1点体质。无豁免惩罚。
  6级：目标受到4点毒素伤害，损失1点体质。豁免惩罚-1。
  11级：目标受到6点毒素伤害，损失2点体质。豁免惩罚-2。
  16级：目标受到8点毒素伤害，损失2点体质。豁免惩罚-3。
  21级：目标受到10点毒素伤害，损失3点体质。豁免惩罚-4。

–10级起，每日可使用一次「猎者捕网陷阱」能力。

猎者捕网陷阱：这是一种强力陷阱，用于致残并标记目标。陷阱造成10d10+20点远程伤害，若目标死亡豁免失败（每8级豁免惩罚-1）则陷入麻痹；否则目标移动速度大幅降低，且会不受控制地流血，4回合内额外造成24点伤害。此外，流血期间目标会被暴露，在友方视野外也保持可见，且无法进入潜行或隐形状态。猎者捕网陷阱的次级效果对不死生物、元素生物与虚体生物无效。
职业限制：
–无法施展任何德鲁伊法术。
–无法兼职。
–无法穿戴重于钉皮甲的护甲。
–无法使用「魅惑动物」能力。~)
	
    briefdesc     = RESOLVE_STR_REF(~黑暗猎人：黑暗猎人将潜行与生存技艺用于渗透、谍报与追猎，必要时正面作战的能力也毫不逊色。在普通林间游侠眼中，他们不过是名义上的游侠；但在公会与权势集团中，作为刺客与情报搜集者的黑暗猎人往往更受欢迎。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0DHUNT~
	
    unusable      = ~0x00010000~
